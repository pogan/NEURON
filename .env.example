# Środowisko EUIPO: production | sandbox
ENV=production

# Klucze produkcyjne (https://developer.euipo.europa.eu)
EUIPO_API_KEY=
EUIPO_API_SECRET=

# Klucze systemu testowego — używane gdy ENV=sandbox
EUIPO_SANDBOX_API_KEY=
EUIPO_SANDBOX_API_SECRET=

# Brama hasła — dostęp do całej aplikacji. Puste = strona publiczna.
WEBSITE_PASS=
# Klucz podpisu ciasteczka sesji (opcjonalny; bez niego wyprowadzany z hasła)
SESSION_SECRET=
# Ważność sesji w godzinach (domyślnie 12)
# SESSION_HOURS=12
# Wymuś flagę Secure gdy TLS kończy się na NGINX bez X-Forwarded-Proto
# COOKIE_SECURE=true

# Serwer
HOST=127.0.0.1
PORT=3000

# Ustaw jeśli aplikacja stoi za NGINX w podkatalogu, np. /neuron
BASE_PATH=

# Baza SQLite z danymi aplikacji (domyślnie ./data/neuron.sqlite) — objęta kopią zapasową
# DB_FILE=/var/lib/neuron/neuron.sqlite
# Kopia rejestrów EUIPO/UPRP (domyślnie registry.sqlite obok DB_FILE) — da się odbudować z API
# REGISTRY_DB_FILE=/var/lib/neuron/registry.sqlite

# Dzienne limity zapytań (doba UTC). Import w tle zużywa do 80%, odświeżanie do 90%.
# QUOTA_EUIPO_TRADEMARK=6000
# QUOTA_EUIPO_DESIGN=35000
# QUOTA_UPRP=5000

# Nadpisania adresów (zwykle niepotrzebne — wynikają z ENV)
# EUIPO_API_HOST=https://api-sandbox.euipo.europa.eu
# EUIPO_TOKEN_URL=
# EUIPO_SCOPE=uid
