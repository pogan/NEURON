# Środowisko EUIPO: production | sandbox
ENV=production

# Klucze produkcyjne (https://developer.euipo.europa.eu)
EUIPO_API_KEY=
EUIPO_API_SECRET=

# Klucze systemu testowego — używane gdy ENV=sandbox
EUIPO_SANDBOX_API_KEY=
EUIPO_SANDBOX_API_SECRET=

# Serwer
HOST=127.0.0.1
PORT=3000

# Ustaw jeśli aplikacja stoi za NGINX w podkatalogu, np. /neuron
BASE_PATH=

# Baza SQLite (domyślnie ./data/neuron.sqlite)
# DB_FILE=/var/lib/neuron/neuron.sqlite

# Nadpisania adresów (zwykle niepotrzebne — wynikają z ENV)
# EUIPO_API_HOST=https://api-sandbox.euipo.europa.eu
# EUIPO_TOKEN_URL=
# EUIPO_SCOPE=uid
