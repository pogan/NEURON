<!doctype html>
<html lang="pl" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>NEURON — <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="<%= base %>/static/css/style.css?v=<%= v %>" rel="stylesheet">
</head>
<body class="nrn-login">

<div class="modal d-block" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content nrn-login-card">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title d-flex align-items-center gap-2">
          <i class="bi bi-diagram-3 text-primary"></i> NEURON
        </h5>
      </div>
      <form method="post" action="<%= base %>/login" autocomplete="off">
        <div class="modal-body">
          <p class="text-secondary small mb-3">Dostęp do aplikacji wymaga hasła.</p>

          <input type="hidden" name="next" value="<%= next %>">
          <label class="form-label small" for="password">Hasło</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
            <input
              class="form-control <%= error ? 'is-invalid' : '' %>"
              type="password"
              id="password"
              name="password"
              autofocus
              required
            >
          </div>

          <% if (error) { %>
            <div class="text-danger small mt-2"><i class="bi bi-exclamation-triangle me-1"></i><%= error %></div>
          <% } %>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button class="btn btn-primary w-100" type="submit">
            <i class="bi bi-box-arrow-in-right me-1"></i> Wejdź
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

</body>
</html>
