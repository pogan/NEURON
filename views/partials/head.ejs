<!doctype html>
<html lang="pl" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NEURON — <%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="<%= base %>/static/css/style.css?v=<%= v %>" rel="stylesheet">
  <script>window.NEURON_BASE = <%- JSON.stringify(base) %>;</script>
</head>
<body>
<nav class="navbar navbar-expand-lg border-bottom sticky-top nrn-nav">
  <div class="container-xl">
    <a class="navbar-brand d-flex align-items-center gap-2" href="<%= base %>/">
      <i class="bi bi-diagram-3"></i><span class="fw-semibold">NEURON</span>
      <% if (env === 'sandbox') { %>
        <span class="badge text-bg-warning nrn-env" title="Praca na systemie testowym EUIPO">SANDBOX</span>
      <% } %>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainnav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainnav">
      <ul class="navbar-nav me-auto">
        <% nav.forEach(function (item) { %>
          <li class="nav-item">
            <a class="nav-link <%= page === item.href ? 'active' : '' %>" href="<%= base %><%= item.href %>">
              <i class="bi <%= item.icon %> me-1"></i><%= item.label %>
            </a>
          </li>
        <% }); %>
      </ul>
      <div class="d-flex align-items-center gap-3">
        <span class="nrn-token small text-secondary" id="tokenStatus">
          <i class="bi bi-shield-lock"></i> <span>sprawdzam…</span>
        </span>
        <button class="btn btn-sm btn-outline-secondary" id="themeToggle" title="Przełącz motyw">
          <i class="bi bi-circle-half"></i>
        </button>
        <% if (typeof auth !== 'undefined' && auth) { %>
          <form method="post" action="<%= base %>/logout" class="m-0">
            <button class="btn btn-sm btn-outline-secondary" type="submit" title="Wyloguj">
              <i class="bi bi-box-arrow-right"></i>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<main class="container-xl py-4">
